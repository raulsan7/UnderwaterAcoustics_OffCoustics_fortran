+SUBROUTINE save_hdf5_real_3d(filepath, var_name, data_array)
+    ! -------------------------------------------------------------------------
+    ! save_to_hdf5 overload for a rank-3 REAL(WP) array, written as a
+    ! rank-3 H5T_NATIVE_DOUBLE dataset.
