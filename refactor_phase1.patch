-FUNCTION extract_number_nodes(text_line) RESULT(number_of_nodes)
-    ! -------------------------------------------------------------------------
-    ! Extracts the integer node count from an SD.sum.yaml line of the form
-    ! "Nodes: # 33 x 9", i.e. the number found between the '#' and the 'x'.
