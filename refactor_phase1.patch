+    end if
+
+    close(unit_num)
+
+    ! --- 4. Pack values into Config_t --- !
+    config % run_inputs % params_decay % distance_decay = distance_decay
+    config % run_inputs % params_decay % n_decay        = n_decay
+    config % run_inputs % params_decay % z_decay        = z_decay
