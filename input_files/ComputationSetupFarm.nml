! =====================================================================
! Post-processing configuration file (wind farm)
! =====================================================================
! Configures every observer-geometry post-processing step that run()
! can execute for a wind farm (simulation_type = 'farm' in Solver.nml).
! Sphere and decay have no meaning for a farm (no single turbine to
! enclose or to follow downstream) and are always skipped, even with
! do_all = .true.; use run_line with explicit end points instead of decay.
!
! - do_config (below): one "do_<name>" logical per step, all together,
!   deciding whether run() executes it at all (.false. skips it
!   entirely). Kept separate from the per-step parameters so every
!   on/off switch is visible in one place.
! - Each step then has its own namelist group, named after the routine
!   it configures, with the same optional parameters that routine
!   already accepts today, using the exact same variable names.
!
! Auto-default convention: -999.0 (reals) or -999 (integers) requests the
! value computed at run time. For a farm, the automatic centre is the
! farm centroid (mean turbine axis) and z = -Depth/2.
!
! Values below are chosen for the layout of WindFarm.nml:
!   turbine 1 at (0, 0), turbine 2 at (1000, 0), depth 30 m,
!   farm centroid (500, 0), wind along +x (WindDir = 0).
! Points, circles, lines and the XY/XZ slices stay tens of metres away
! from both turbine axes. Observers closer than 5 m to any source node
! (inside the structure) are never computed: their pressure is saved as
! NaN, so vertical slices through the turbines show a hole there.
! Revise the values if the layout changes.
!
! Cost: every step scales with Nobservers x Nfrequencies x Nmodes x
! Nsources. With filter_freqs = .false. (10000 frequencies, 45 modes)
! large grids are slow; use filter_freqs = .true. to iterate quickly.
! =====================================================================


! ---------------------------------------------------------------
! Which post-processing steps to run
! ---------------------------------------------------------------
&do_config
    do_all           = .false.   ! [-] .true. runs every step valid for a farm (all but decay and sphere)
    do_spectrums     = .true.    ! [-] Spectrums at observer points (run_spectrums)
    do_polar         = .true.    ! [-] Polar contour around the farm (run_polar)
    do_cylinder      = .false.   ! [-] Cylinder surface around the farm (run_cylinder), 1440 observers
    do_decay         = .false.   ! [-] Not available for a wind farm (always skipped): see line_config
    do_line          = .true.    ! [-] Line between two points (run_line): downstream decay of the farm
    do_sliceXY       = .true.    ! [-] Horizontal slice XY over the whole farm (run_sliceXY)
    do_sliceXZ       = .false.   ! [-] Vertical slice XZ beside the turbine row (run_sliceXZ)
    do_sliceVertical = .true.    ! [-] Vertical slice along the turbine row (run_sliceVertical)
    do_sphere        = .false.   ! [-] Not available for a wind farm (always skipped)
/


! ---------------------------------------------------------------
! Spectrums at observer points (run_spectrums)
! ---------------------------------------------------------------
! 1: 500 m upstream of turbine 1       2: midpoint between both turbines
! 3: 500 m downstream of turbine 2     4: 500 m abeam of the farm centroid
! 5: 100 m abeam of turbine 1          6: 100 m abeam of turbine 2
! (points 5 and 6 compare both operating points, 11.4 vs 8.0 m/s)
&spectrums_config
    n_observers = 6                                            ! [-] Number of observers listed below
    observers_x = -500.0, 500.0, 1500.0, 500.0,   0.0, 1000.0   ! [m] x-coordinate of the observers
    observers_y =    0.0,   0.0,    0.0, 500.0, 100.0,  100.0   ! [m] y-coordinate of the observers
    observers_z =  -15.0, -15.0,  -15.0, -15.0, -15.0,  -15.0   ! [m] z-coordinate of the observers (mid-depth)
/


! ---------------------------------------------------------------
! Polar contour (run_polar)
! ---------------------------------------------------------------
! Centred on the farm centroid (500, 0); r = 1000 m passes 500 m beyond
! each turbine along the row, at (-500, 0) and (1500, 0).
&polar_config
    r_polar = 1000.0                ! [m] Radius of the polar circle around the farm centroid
    z_polar = -999.0                ! [m] Depth of the polar circle (-999.0 = auto: -Depth/2)
    n_polar = 72                    ! [-] Number of azimuthal observer points (5 deg spacing)
    center_polar = -999.0, -999.0   ! [m] Circle centre (x, y); -999.0 = auto: farm centroid (500, 0)
/


! ---------------------------------------------------------------
! Cylinder surface (run_cylinder)
! ---------------------------------------------------------------
! Same circle as the polar contour, over the whole water column.
&cylinder_config
    r_cyl = 1000.0                  ! [m] Radius of the cylindrical surface around the farm centroid
    n_cyl = 72                      ! [-] Number of azimuthal observer points around the cylinder
    nz_cyl = 20                     ! [-] Number of vertical observer levels along the cylinder
    center_cyl = -999.0, -999.0     ! [m] Cylinder axis centre (x, y); -999.0 = auto: farm centroid (500, 0)
/


! ---------------------------------------------------------------
! Line between two points (run_line)
! ---------------------------------------------------------------
! Replaces decay for the farm: along the wind (+x) at mid-depth, from
! 10 m behind turbine 2 to 2 km behind it (downstream decay of the farm).
&line_config
    p1_line = 1010.0, 0.0, -15.0    ! [m] Line start point (x, y, z): 10 m downstream of turbine 2
    p2_line = 3000.0, 0.0, -15.0    ! [m] Line end point (x, y, z): 2 km downstream of turbine 2
    n_line = 200                    ! [-] Number of observer points along the line (~10 m spacing)
    logspace_line = .false.         ! [-] Whether to space the observer points logarithmically instead of linearly
/


! ---------------------------------------------------------------
! Horizontal slice XY (run_sliceXY)
! ---------------------------------------------------------------
! Whole farm plus a 1 km margin around it. dx = 50 m; ny is even so
! y = 0 (the turbine row) is never on the grid: the closest observers
! stay ~34 m away from both turbine axes.
&sliceXY_config
    z_xy = -999.0                   ! [m] Depth of the horizontal slice (-999.0 = auto: -Depth/2)
    nx_xy = 61                      ! [-] Number of observer points along x (dx = 50 m)
    ny_xy = 30                      ! [-] Number of observer points along y (dy ~ 69 m, even: skips y = 0)
    xlim_xy = -1000.0, 2000.0       ! [m] Slice extent along x (min, max)
    ylim_xy = -1000.0, 1000.0       ! [m] Slice extent along y (min, max)
    center_xy = -999.0, -999.0      ! [m] Slice centre (x, y); -999.0 = auto: midpoint of xlim_xy/ylim_xy
/


! ---------------------------------------------------------------
! Vertical slice XZ (run_sliceXZ)
! ---------------------------------------------------------------
! Parallel to the turbine row, 50 m beside it (y = 0 would cut through
! both structures; that plane is covered by sliceVertical below).
&sliceXZ_config
    y_xz = 50.0                     ! [m] y-position of the vertical slice, 50 m beside the turbine row
    nx_xz = 61                      ! [-] Number of observer points along x (dx = 50 m)
    nz_xz = 16                      ! [-] Number of observer points along z (dz = 2 m)
    xlim_xz = -1000.0, 2000.0       ! [m] Slice extent along x (min, max)
    zlim_xz = 0.0, -999.0           ! [m] Slice extent along z (min, max); max = -999.0 = auto: -Depth
/


! ---------------------------------------------------------------
! Vertical slice at any azimuth (run_sliceVertical)
! ---------------------------------------------------------------
! The plane normal points along azimuth_sv (0 deg: normal to +x,
! anticlockwise); the plane spans the horizontal axis (-sin, cos) of
! that azimuth and the depth. azimuth_sv = -90.0 gives the XZ plane
! with the span axis along +x, i.e. the vertical plane through the
! turbine row. The automatic width covers both turbines; margin_sv =
! 500 m extends it 500 m beyond each one: x from -500 to 1500 m.
! The plane crosses both monopiles: observers closer than 5 m to their
! nodes are masked (NaN pressure) instead of computed.
&sliceVertical_config
    azimuth_sv = -90.0              ! [deg] Azimuth of the plane normal: -90 = plane through the turbine row
    center_sv = -999.0, -999.0      ! [m] Plane centre (x, y); -999.0 = auto: farm centroid (500, 0)
    width_sv = -999.0               ! [m] Full horizontal span; -999.0 = auto: every source projected + margin_sv
    zlim_sv = -999.0, 0.0           ! [m] Depth extent (min, max); -999.0 = auto: -Depth (min) or 0 (max)
    nu_sv = 200                     ! [-] Points along the span (du ~ 10 m over 2000 m)
    nz_sv = 16                      ! [-] Points along z (dz = 2 m)
    margin_sv = 500.0               ! [m] Margin added on both sides of the turbine row
/


! Mandatory: Leave blank space at the end of the file
