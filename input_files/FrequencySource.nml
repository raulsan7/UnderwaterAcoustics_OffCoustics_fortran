! =====================================================================
! Frequency-domain point sources configuration file
! =====================================================================
! Used when simulation_type = 'FrequencySource' in Solver.nml: a few
! hand-made point dipoles, each one radiating at the frequencies of
! freqs with a complex force given directly in the frequency domain
! (no OpenFAST, no FFT window, no radiation-impedance correction).
!
! Conventions
!   - Frame: x, y horizontal, z positive upwards, free surface at z = 0
!     (sources are in the water: z between -depth_base and 0).
!   - Force: force applied by the source on the fluid [N], components
!     (Fx, Fy, Fz) in the global frame. The pressure of every dipole is
!     p = (F.r_hat) * (1/r - i*k) * exp(i*k*r) / (4*pi*r).
!   - Time factor exp(-i*2*pi*f*t), the one of the acoustic solvers:
!         F(t) = Re{ (force_re + i*force_im) * exp(-i*2*pi*f*t) }
!     so force_re + i*force_im is the PEAK complex amplitude (not RMS)
!     of a sinusoidal force: A*cos(2*pi*f*t) is force_re = A, and
!     A*sin(2*pi*f*t) is force_im = +A. The relative phase between
!     sources and between components is kept.
!
! Layout of the arrays: force_re(i_f, i_s, 1:3) is the force of source
! i_s at frequency i_f, one line per (frequency, source) with its three
! components. Every force_re entry is mandatory (a missing one stops
! the run); force_im is optional and every entry left out is 0.
! Limits of this input: 20 sources and 200 frequencies.
! =====================================================================

&frequency_source_config
    Nsources = 2                                ! [-] Number of sources
    Nfreqs   = 3                                ! [-] Number of frequencies

    freqs = 25.0, 50.0, 100.0                   ! [Hz] Frequencies, strictly increasing (Nfreqs)

    ! Source positions: source_xyz(i_s, 1:3) = x, y, z
    source_xyz(1, 1:3) =  0.0, 0.0, -10.0       ! [m] Source 1
    source_xyz(2, 1:3) = 10.0, 0.0, -10.0       ! [m] Source 2

    ! Force, real part: force_re(i_f, i_s, 1:3) = Fx, Fy, Fz
    force_re(1, 1, 1:3) = 0.0, 0.0, 1000.0      ! [N] f1 =  25 Hz, source 1: vertical force
    force_re(1, 2, 1:3) = 0.0, 0.0,    0.0      ! [N] f1 =  25 Hz, source 2: only imaginary part (see below)
    force_re(2, 1, 1:3) = 300.0, 0.0, 500.0     ! [N] f2 =  50 Hz, source 1: oblique force
    force_re(2, 2, 1:3) = 0.0, 0.0,    0.0      ! [N] f2 =  50 Hz, source 2: silent at this frequency
    force_re(3, 1, 1:3) = 0.0, 0.0,  200.0      ! [N] f3 = 100 Hz, source 1
    force_re(3, 2, 1:3) = 0.0, 0.0, -200.0      ! [N] f3 = 100 Hz, source 2: 180 deg out of phase with source 1

    ! Force, imaginary part (optional): force_im(i_f, i_s, 1:3) = Fx, Fy, Fz
    force_im(1, 2, 1:3) = 0.0, 0.0, 1000.0      ! [N] f1 =  25 Hz, source 2: A*sin(wt), lags source 1 by 90 deg
/


! Mandatory: Leave blank space at the end of the file
