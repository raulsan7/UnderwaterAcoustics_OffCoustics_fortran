! =====================================================================
! Solver configuration file
! =====================================================================

&solver_config
    method = 'AnalyticalNormalModes'    ! [-] Acoustic solver: 'ImageMethod' or 'AnalyticalNormalModes'
    save_path = 'None'        ! [-] Output file base path/name; 'None'/'Default' builds it from the turbine/solver settings
    block_size = 128          ! [-] Number of observers processed together per parallel block
    in_cluster = .true.       ! [-] Whether to use multi-threaded/blocked pressure evaluation (cluster/HPC run)
    debug = .true.            ! [-] Whether to print extra diagnostic info (e.g. pressure norms) during the run
/


! Mandatory: Leave blank space at the end of the file