! =====================================================================
! Wind farm configuration file
! =====================================================================
! &farm_config : settings shared by every turbine (they define the
!                common frequency grid). The water depth comes from
!                Environment.nml.
! &turbine     : one block per turbine, in order. A variable left out
!                takes its default, never the previous block's value.
! =====================================================================

&farm_config
    From = 0.9                  ! [-] Fraction of the time series to start reading from
    Upto = 1.0                  ! [-] Fraction of the time series to stop reading at
    skip = 1                    ! [-] Keep 1 out of every "skip" time samples
    skipf = 1                   ! [-] Keep 1 out of every "skipf" frequency bins
    filter_freqs = .false.      ! [-] Whether to discard frequencies far from the drivetrain excitation peaks
    freqs_over = 10.0           ! [Hz] Frequencies below this value are never filtered out
/


! --- Turbine 1 --- !
&turbine
    case_type = 'DTU10MWMonopile'          ! [-] Turbine model
    rootname = 'DTU_DeltaWind_mn_ws11.4'   ! [-] OpenFAST run name (no extension)
    OP_output_dir = '../OP_output/'        ! [-] Directory of the OpenFAST output/SubDyn files
    WindSpeed = 11.4                       ! [m/s] Wind speed of this operating point
    WindDir = 0.0                          ! [deg] Wind direction (0 deg points to +x, anticlockwise)
    AxisPos = 0.0, 0.0                     ! [m] Turbine axis (x, y) position in the global frame
    Nmembers = 8                           ! [-] Number of structural members in the SD.sum.yaml
    Nnodes = 5                             ! [-] Number of structural nodes per member
/


! --- Turbine 2 --- !
&turbine
    case_type = 'DTU10MWMonopile'
    rootname = 'DTU_DeltaWind_mn_ws8.0'
    OP_output_dir = '../OP_output/'
    WindSpeed = 8.0
    WindDir = 0.0
    AxisPos = 1000.0, 0.0
    Nmembers = 8
    Nnodes = 5
/


! Mandatory: Leave blank space at the end of the file