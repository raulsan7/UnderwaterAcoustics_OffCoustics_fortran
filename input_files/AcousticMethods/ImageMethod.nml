! =====================================================================
! Images method configuration file
! =====================================================================

&ImagesMethod_config

    ! --- Image construction --- !
    N_images = 30                  ! [-] Number of image source levels used to enforce the boundary conditions

    ! --- Boundary conditions --- !
    UpperBC = -1                   ! [-] Upper boundary type: -1 = pressure-release (p=0), +1 = rigid (dp/dn=0)
    LowerBC = 1                    ! [-] Lower boundary type: -1 = pressure-release (p=0), +1 = rigid (dp/dn=0)

    ! --- Attenuation and numerical tolerance --- !
    attenuation_surface = 1.0      ! [-] Attenuation coefficient applied to surface-reflected images
    attenuation_bottom = 0.5       ! [-] Attenuation coefficient applied to bottom-reflected images
    epsilon = 1.0e-6               ! [-] Minimum source-observer distance, avoids singularities near a dipole

/


! Mandatory: Leave blank space at the end of the file
