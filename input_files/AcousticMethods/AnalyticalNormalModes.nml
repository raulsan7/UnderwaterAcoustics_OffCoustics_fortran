! =====================================================================
! Analytical normal modes configuration file
! =====================================================================

&AnalyticalNormalModes_config

    ! --- Modal expansion --- !
    Nmodes = -999                  ! [-] Number of normal modes retained (-999 = auto: propagating modes at f_max + 5)

    ! --- Numerical tolerance --- !
    epsilon = 1.0e-6              ! [m] Minimum horizontal source-observer distance, avoids the r=0 singularity

/


! Mandatory: Leave blank space at the end of the file
