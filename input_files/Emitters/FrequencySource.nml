! =====================================================================
! Frequency-domain point sources configuration file
! =====================================================================
! Used when simulation_type = 'FrequencySource' in Solver.nml: hand-made
! point dipoles, each one radiating at every frequency of the axis with
! a complex force given directly in the frequency domain (no OpenFAST,
! no FFT window, no radiation-impedance correction).
!
! Conventions
!   - Frame: x, y horizontal, z positive upwards, free surface at z = 0
!     (sources must be in the water: z between the seabed and 0).
!   - Force: force applied by the source on the fluid [N], components
!     (Fx, Fy, Fz) in the global frame. The pressure of every dipole is
!         p = (F.r_hat) * (1/r - i*k) * exp(i*k*r) / (4*pi*r)
!   - Time factor exp(-i*2*pi*f*t), the one of the acoustic solvers:
!         F(t) = Re{ (Re F + i*Im F) * exp(-i*2*pi*f*t) }
!     so Re F + i*Im F is the PEAK complex amplitude (not RMS) of a
!     sinusoidal force: A*cos(2*pi*f*t) is Re F = A, and A*sin(2*pi*f*t)
!     is Im F = +A. The relative phase between sources and between
!     components is kept.
!   - Every frequency is a tone. If the frequencies are uniformly spaced
!     (step df), the plots also give the PSD and the 1/3 octave bands,
!     taking each tone as the power of a band df wide. To represent a
!     continuous force spectrum S_F(f) [N^2/Hz], give
!         |F_k| = sqrt(2 * S_F(f_k) * df)
!     For isolated tones the PSD has no physical meaning (it depends on
!     df): use the SPL.
!
! Every item is given in ONE of these ways: the one that has values is
! used, and two at once stop the run (comment out with ! the values of
! the way not used).
!   Positions   (a) source_xyz(i_s, 1:3) = x, y, z: at most 20 sources
!               (b) source_file: one row x y z per source, any number;
!                   Nsources is then -999 or the number of rows
!   Frequencies (a) freqs = f1, f2, ... (Nfreqs values): at most 200
!               (b) a grid of Nfreqs frequencies from fmin (> 0) to fmax:
!                   freq_spacing = 'linear' (constant step) or 'log'
!                   (constant ratio)
!               (c) freq_file: one frequency per row, any number; Nfreqs
!                   is then -999 or the number of rows
!               The frequencies must be positive and strictly increasing.
!   Forces      (a) force_re(i_f, i_s, 1:3) = Fx, Fy, Fz, one line per
!                   frequency and source (every entry mandatory), and
!                   force_im (optional, 0 if left out): at most 200
!                   frequencies and 20 sources
!               (b) force_re_expr(i_s, 1:3) and force_im_expr(i_s, 1:3):
!                   text expressions of the frequency f [Hz], '0' if left
!                   out, evaluated at every frequency of the axis: at most
!                   20 sources. The language is the one of TimeSource.nml
!                   (with f instead of t): numbers (12, 0.5, 1.0e-3), the
!                   constant pi, the operators + - * / **, parentheses and
!                       sin cos tan asin acos atan sinh cosh tanh exp log
!                       log10 sqrt abs floor atan2 min max mod modulo
!                       step(x)  1 if x >= 0, else 0
!                       sgn(x)   -1, 0 or 1
!                   Examples:  '100/(1+(f/50)**2)'
!                              '500*exp(-((f-80)/10)**2)'
!                              '200*step(f-40)*step(60-f)'
!               (c) force_re_file and force_im_file: one row per frequency
!                   of the axis and 3*Nsources columns,
!                       Fx1 Fy1 Fz1 Fx2 Fy2 Fz2 ...
!                   force_im_file = 'None' means an imaginary part 0.
! Text files: blanks, tabs or commas separate the values; lines starting
! with # or ! are comments. Paths are relative to the working directory.
! In this file comments start with ! (a / ends the namelist group).
! =====================================================================

&frequency_source_config
    ! --- Sources --- !
    Nsources = 1                                ! [-] Number of sources (-999 with source_file: its rows)
    source_xyz(1, 1:3) = 0.0, 0.0, -10.0        ! [m] (a) Source 1: x, y, z
    source_file = 'None'                        ! [-] (b) Text file with the positions, instead of source_xyz

    ! --- Frequency axis --- !
    Nfreqs = 3                                  ! [-] Number of frequencies (-999 with freq_file: its rows)
    freqs  = 15.0, 50.0, 100.0                  ! [Hz] (a) Frequencies
    fmin   = -999.0                             ! [Hz] (b) First frequency of the grid (-999.0 = no grid)
    fmax   = -999.0                             ! [Hz] (b) Last frequency of the grid (-999.0 = no grid)
    freq_spacing = 'linear'                     ! [-] (b) Spacing of the grid: 'linear' or 'log'
    freq_file = 'None'                          ! [-] (c) Text file with the frequencies

    ! --- Force of every source: Fx, Fy, Fz [N] --- !
    force_re(1, 1, 1:3) =  10.0, 0.0, 0.0       ! [N] (a) f1 =  15 Hz, source 1: force along x
    force_re(2, 1, 1:3) = 300.0, 0.0, 0.0       ! [N] (a) f2 =  50 Hz, source 1
    force_re(3, 1, 1:3) = 100.0, 0.0, 0.0       ! [N] (a) f3 = 100 Hz, source 1
    ! force_im(2, 1, 1:3) = 0.0, 0.0, 50.0                      ! [N] (a) Imaginary part (optional)
    ! force_re_expr(1, 1:3) = '0', '0', '100/(1+(f/50)**2)'     ! [N] (b) Real part as a function of f [Hz]
    ! force_im_expr(1, 1:3) = '0', '0', '0'                     ! [N] (b) Imaginary part ('0' if left out)
    force_re_file = 'None'                      ! [-] (c) Text file with the real part
    force_im_file = 'None'                      ! [-] (c) Text file with the imaginary part ('None' = 0)
/


! Mandatory: Leave blank space at the end of the file
