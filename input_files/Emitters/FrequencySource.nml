! =====================================================================
! Frequency-domain point sources configuration file
! =====================================================================
! Used when simulation_type = 'FrequencySource' in Solver.nml: hand-made
! point sources, dipoles or monopoles, each one radiating at every
! frequency of the axis with a complex amplitude given directly in the
! frequency domain (no OpenFAST, no FFT window, no radiation-impedance
! correction).
!
! Conventions
!   - Frame: x, y horizontal, z positive upwards, free surface at z = 0
!     (sources must be in the water: z between the seabed and 0).
!   - Multipole order of every source: source_order(i_s) = 1 for a
!     dipole, 0 for a monopole; a source left out is a dipole.
!   - Dipole: force applied by the source on the fluid [N], components
!     (Fx, Fy, Fz) in the global frame. Its pressure is
!         p = (F.r_hat) * (1/r - i*k) * exp(i*k*r) / (4*pi*r)
!   - Monopole: volume velocity Q [m^3/s] (volume of fluid displaced
!     per second by the source), given in the FIRST component of the
!     force inputs; the second and third are left out or 0 (any other
!     value stops the run). Its pressure is
!         p = -i*w*rho*Q * exp(i*k*r) / (4*pi*r),   w = 2*pi*f
!     with rho the density of Environment.nml. Its free-field pressure
!     amplitude at 1 m is f*rho*|Q|/2, so a source level SL [dB re
!     1 uPa @ 1 m, RMS] is obtained with
!         |Q| = 2*sqrt(2)*1.0e-6 * 10**(SL/20) / (f*rho)
!   - Time factor exp(-i*2*pi*f*t), the one of the acoustic solvers:
!         F(t) = Re{ (Re F + i*Im F) * exp(-i*2*pi*f*t) }
!     so Re F + i*Im F is the PEAK complex amplitude (not RMS) of a
!     sinusoidal force: A*cos(2*pi*f*t) is Re F = A, and A*sin(2*pi*f*t)
!     is Im F = +A. The same holds for Q. The relative phase between
!     sources and between components is kept.
!   - Every frequency is a tone. If the frequencies are uniformly spaced
!     (step df), the plots also give the PSD and the 1/3 octave bands,
!     taking each tone as the power of a band df wide. To represent a
!     continuous force spectrum S_F(f) [N^2/Hz], give
!         |F_k| = sqrt(2 * S_F(f_k) * df)
!     (and |Q_k| = sqrt(2 * S_Q(f_k) * df) for a monopole). For
!     isolated tones the PSD has no physical meaning (it depends on
!     df): use the SPL.
!
! Every item is given in ONE of these ways: the one that has values is
! used, and two at once stop the run (comment out with ! the values of
! the way not used).
!   Positions   (a) source_xyz(i_s, 1:3) = x, y, z: at most 20 sources
!               (b) source_file: one row x y z per source, any number;
!                   Nsources is then -999 or the number of rows
!   Orders      (a) source_order(i_s) = 0 or 1, with source_xyz (1 if
!                   left out)
!               (b) a fourth column of source_file, x y z order (with
!                   three columns every source is a dipole);
!                   source_order cannot be given with source_file
!   Frequencies (a) freqs = f1, f2, ... (Nfreqs values): at most 200
!               (b) a grid of Nfreqs frequencies from fmin (> 0) to fmax:
!                   freq_spacing = 'linear' (constant step) or 'log'
!                   (constant ratio)
!               (c) freq_file: one frequency per row, any number; Nfreqs
!                   is then -999 or the number of rows
!               The frequencies must be positive and strictly increasing.
!   Forces      (a) force_re(i_f, i_s, 1:3) = Fx, Fy, Fz, one line per
!                   frequency and source (every entry mandatory; for a
!                   monopole only force_re(i_f, i_s, 1) = Re Q), and
!                   force_im (optional, 0 if left out): at most 200
!                   frequencies and 20 sources
!               (b) force_re_expr(i_s, 1:3) and force_im_expr(i_s, 1:3):
!                   text expressions of the frequency f [Hz], '0' if left
!                   out, evaluated at every frequency of the axis (for a
!                   monopole only force_re_expr(i_s, 1) and
!                   force_im_expr(i_s, 1)): at most 20 sources. The
!                   language is the one of TimeSource.nml (with f instead
!                   of t): numbers (12, 0.5, 1.0e-3), the constant pi,
!                   the operators + - * / **, parentheses and
!                       sin cos tan asin acos atan sinh cosh tanh exp log
!                       log10 sqrt abs floor atan2 min max mod modulo
!                       step(x)  1 if x >= 0, else 0
!                       sgn(x)   -1, 0 or 1
!                   Examples:  '100/(1+(f/50)**2)'
!                              '500*exp(-((f-80)/10)**2)'
!                              '200*step(f-40)*step(60-f)'
!                              '2*sqrt(2)*1.0e-6*10**(150/20)/(f*1025)'
!                              (Q of a monopole of SL = 150 dB, rho = 1025)
!               (c) force_re_file and force_im_file: one row per frequency
!                   of the axis and 3*Nsources columns,
!                       Fx1 Fy1 Fz1 Fx2 Fy2 Fz2 ...
!                   (a monopole: Q in its first column, 0 in the other
!                   two); force_im_file = 'None' means an imaginary part 0.
! Text files: blanks, tabs or commas separate the values; lines starting
! with # or ! are comments. Paths are relative to the working directory.
! In this file comments start with ! (a / ends the namelist group).
! =====================================================================

&frequency_source_config
    ! Debug case of group_by_axes: 7 sources on 2 vertical axes, both of them mixed (dipoles and monopoles)
    !   Axis A, (x, y) = ( 0.0,  0.0): sources 1-3 (dipole, monopole, dipole)
    !   Axis B, (x, y) = (40.0, 25.0): sources 4-7 (dipole, dipole, monopole, dipole)

    ! --- Sources --- !
    Nsources = 7                                ! [-] Number of sources (-999 with source_file: its rows)
    source_xyz(1, 1:3) =  0.0,  0.0,  -5.0      ! [m] (a) Source 1: x, y, z (axis A)
    source_xyz(2, 1:3) =  0.0,  0.0, -12.0      ! [m] (a) Source 2 (axis A)
    source_xyz(3, 1:3) =  0.0,  0.0, -20.0      ! [m] (a) Source 3 (axis A)
    source_xyz(4, 1:3) = 40.0, 25.0,  -3.0      ! [m] (a) Source 4 (axis B)
    source_xyz(5, 1:3) = 40.0, 25.0,  -9.0      ! [m] (a) Source 5 (axis B)
    source_xyz(6, 1:3) = 40.0, 25.0, -16.0      ! [m] (a) Source 6 (axis B)
    source_xyz(7, 1:3) = 40.0, 25.0, -24.0      ! [m] (a) Source 7 (axis B)
    source_order(1:7) = 1, 0, 1, 1, 1, 0, 1     ! [-] (a) 1 dipole, 0 monopole (1 if left out)
    source_file = 'None'                        ! [-] (b) Text file, rows x y z [order], instead of (a)

    ! --- Frequency axis --- !
    Nfreqs = 3                                  ! [-] Number of frequencies (-999 with freq_file: its rows)
    freqs  = 15.0, 50.0, 100.0                  ! [Hz] (a) Frequencies
    fmin   = -999.0                             ! [Hz] (b) First frequency of the grid (-999.0 = no grid)
    fmax   = -999.0                             ! [Hz] (b) Last frequency of the grid (-999.0 = no grid)
    freq_spacing = 'linear'                     ! [-] (b) Spacing of the grid: 'linear' or 'log'
    freq_file = 'None'                          ! [-] (c) Text file with the frequencies

    ! --- Every source: Fx, Fy, Fz [N] (dipole) or Q [m^3/s] in the first component (monopole) --- !
    force_re(1, 1, 1:3) =  10.0,   0.0,   0.0   ! [N] (a) f1 =  15 Hz, source 1 (dipole, axis A)
    force_re(2, 1, 1:3) = 300.0,   0.0,   0.0   ! [N] (a) f2 =  50 Hz, source 1
    force_re(3, 1, 1:3) = 100.0,   0.0,   0.0   ! [N] (a) f3 = 100 Hz, source 1
    force_re(1, 2, 1)   = 1.0e-3                ! [m^3/s] (a) f1, source 2 (monopole, axis A): Re Q
    force_re(2, 2, 1)   = 3.0e-2                ! [m^3/s] (a) f2, source 2
    force_re(3, 2, 1)   = 1.0e-2                ! [m^3/s] (a) f3, source 2
    force_re(1, 3, 1:3) =   0.0,  20.0,  50.0   ! [N] (a) f1, source 3 (dipole, axis A)
    force_re(2, 3, 1:3) =   0.0, 150.0, 200.0   ! [N] (a) f2, source 3
    force_re(3, 3, 1:3) =   0.0,  80.0, 100.0   ! [N] (a) f3, source 3
    force_re(1, 4, 1:3) =  30.0,  30.0,   0.0   ! [N] (a) f1, source 4 (dipole, axis B)
    force_re(2, 4, 1:3) = 100.0, 100.0,   0.0   ! [N] (a) f2, source 4
    force_re(3, 4, 1:3) =  50.0,  50.0,   0.0   ! [N] (a) f3, source 4
    force_re(1, 5, 1:3) =   0.0,   0.0,  80.0   ! [N] (a) f1, source 5 (dipole, axis B)
    force_re(2, 5, 1:3) =   0.0,   0.0, 250.0   ! [N] (a) f2, source 5
    force_re(3, 5, 1:3) =   0.0,   0.0, 120.0   ! [N] (a) f3, source 5
    force_re(1, 6, 1)   = 2.0e-3                ! [m^3/s] (a) f1, source 6 (monopole, axis B): Re Q
    force_re(2, 6, 1)   = 1.0e-2                ! [m^3/s] (a) f2, source 6
    force_re(3, 6, 1)   = 5.0e-3                ! [m^3/s] (a) f3, source 6
    force_re(1, 7, 1:3) =  40.0, -20.0,  10.0   ! [N] (a) f1, source 7 (dipole, axis B)
    force_re(2, 7, 1:3) = 200.0, -50.0,  60.0   ! [N] (a) f2, source 7
    force_re(3, 7, 1:3) =  90.0, -30.0,  30.0   ! [N] (a) f3, source 7
    force_im(2, 4, 1:3) =   0.0,   0.0,  40.0   ! [N] (a) Imaginary part (optional): f2, source 4
    force_im(2, 6, 1)   = 5.0e-3                ! [m^3/s] (a) Imaginary part: f2, source 6 (Im Q)
    force_re_file = 'None'                      ! [-] (c) Text file with the real part
    force_im_file = 'None'                      ! [-] (c) Text file with the imaginary part ('None' = 0)
/


! Mandatory: Leave blank space at the end of the file
