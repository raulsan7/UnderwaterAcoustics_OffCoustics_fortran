diff -ruN a/src/emitters/ManualSources.f90 b/src/emitters/ManualSources.f90
--- a/src/emitters/ManualSources.f90	1970-01-01 01:00:00.000000000 +0100
+++ b/src/emitters/ManualSources.f90	2026-10-06 18:21:50.689237191 +0200
@@ -0,0 +1,157 @@
+! ===============================================================================
+! MODULE: ManualSources
+! ===============================================================================
+! Defines ManualSources_t, the parent of the emitters made of a few
+! point dipoles placed by hand (FrequencySource, TimeSource). Whatever way
+! their forces are given, they reach the solver as complex forces per
+! frequency, so everything from there on is shared: the sources handed to the
+! solver (to_source), the datasets of the HDF5 output (save_params) and the
+! block of the .dat summary with the positions (write_txt). A child sets its
+! data, the three labels below, and adds what is its own.
+! -------------------------------------------------------------------------------
+! Author  : Raul Sanz Ramirez
+! Contact : raul.sanz.ramirez@upm.es
+! Affil.  : ETSIAE, Universidad Politecnica de Madrid
+! Project : ERC project off-coustics
+! Date    : 10/2026
+! ===============================================================================
+MODULE ManualSources
+
+USE Kinds, ONLY: I32, WP
+USE Emitter, ONLY: Emitter_t
+USE ConfigTypes, ONLY: Config_t
+USE HDF5Utils, ONLY: save_variable
+USE SourceTypes, ONLY: AcousticSource_t
+
+IMPLICIT NONE
+
+PRIVATE
+PUBLIC :: ManualSources_t
+
+
+TYPE, EXTENDS(Emitter_t) :: ManualSources_t
+    ! -------------------------------------------------------------------------
+    ! Point dipoles with a complex force per frequency. The emitter keeps its
+    ! own copy of the data because it outlives to_source: the solver moves the
+    ! arrays of the AcousticSource_t away, while save_params and write_txt
+    ! still need them.
+    ! -------------------------------------------------------------------------
+
+    ! --- Labels, set by every child --- !
+    CHARACTER(len=32) :: kind_name      ! [-] Name of the emitter, saved as the Emitter dataset
+    CHARACTER(len=40) :: title          ! [-] Title of its block of the .dat summary
+    CHARACTER(len=16) :: name_suffix    ! [-] End of the default output name (e.g. '_Nf3')
+
+    ! --- Sources, as the solver receives them --- !
+    INTEGER(I32)              :: Nsources       ! [-] Number of sources
+    INTEGER(I32), ALLOCATABLE :: order(:)       ! [-] Multipole order per source
+    REAL(WP)    , ALLOCATABLE :: Freqs(:)       ! [Hz] Frequency vector (Nfreqs)
+    REAL(WP)    , ALLOCATABLE :: xyz(:,:)       ! [m] Source coordinates (Nsources, 3)
+    COMPLEX(WP) , ALLOCATABLE :: Force(:,:,:)   ! [N] Complex force on the fluid (Nfreqs, Nsources, 3)
+
+    CONTAINS
+
+    ! --- Shared procedures --- !
+    PROCEDURE :: to_source   => to_source_ManualSources      ! Converts the emitter to an AcousticSource_t
+    PROCEDURE :: save_params => save_params_ManualSources    ! Saves the sources to HDF5
+    PROCEDURE :: write_txt   => write_txt_ManualSources      ! Writes the title and the positions to the .dat
+
+END TYPE ManualSources_t
+
+
+CONTAINS
+
+
+SUBROUTINE to_source_ManualSources(self, config, sources)
+    ! -------------------------------------------------------------------------
+    ! Translates the sources into the AcousticSource_t consumed by the acoustic
+    ! solvers. No radiation-impedance correction is applied: the forces are the
+    ! ones of the input. The arrays are copied, not moved, because save_params
+    ! and write_txt need the emitter data after the solver has taken the
+    ! sources. The reference centre and origin are the mean of the source
+    ! positions (x, y) and the reference direction is 0 deg (+x).
+    ! -------------------------------------------------------------------------
+
+    CLASS(ManualSources_t), INTENT(INOUT)            :: self      ! [-] Emitter instance
+    TYPE(Config_t)        , INTENT(IN)               :: config    ! [-] Global configuration
+    TYPE(AcousticSource_t), INTENT(OUT), ALLOCATABLE :: sources   ! [-] Acoustic point-dipole sources
+
+    ! Local variables
+    CHARACTER(len=16) :: ns_str
+
+
+    ALLOCATE(AcousticSource_t :: sources)
+
+    sources % xyz   = self % xyz
+    sources % Force = self % Force
+    sources % Freqs = self % Freqs
+    sources % order = self % order
+
+    ! Reference geometry and default output labels read by the solver
+    write(ns_str, '(I0)') self % Nsources
+
+    sources % geometry % center      = sum(self % xyz(:, 1:2), dim=1) / real(self % Nsources, WP)
+    sources % geometry % origin      = sources % geometry % center
+    sources % geometry % direction   = 0.0_WP
+    sources % geometry % out_dir     = './source_acoustic_data/'
+    sources % geometry % name_tag    = 'Source_Ns' // trim(ns_str) // trim(self % name_suffix)
+    sources % geometry % name_suffix = ''
+
+    write(*,*) ">> [AcousticSource] Frequency-domain forces handed to the solver as point dipoles"
+
+END SUBROUTINE to_source_ManualSources
+
+
+SUBROUTINE save_params_ManualSources(self, save_path)
+    ! -------------------------------------------------------------------------
+    ! Saves the emitter type, the number of sources and frequencies, and the
+    ! sources themselves into the HDF5 output file: positions (Nsources, 3),
+    ! multipole order (Nsources) and complex forces (Nfreqs, Nsources, 3).
+    ! -------------------------------------------------------------------------
+
+    CLASS(ManualSources_t), INTENT(IN) :: self         ! [-] Emitter instance
+    CHARACTER(len=*)      , INTENT(IN) :: save_path    ! [-] Path to the HDF5 output file
+
+
+    CALL save_variable(save_path, "Emitter"     , trim(self % kind_name))
+    CALL save_variable(save_path, "Nsources"    , self % Nsources)
+    CALL save_variable(save_path, "NFreqs"      , size(self % Freqs))
+    CALL save_variable(save_path, "Source_xyz"  , self % xyz)
+    CALL save_variable(save_path, "Source_order", self % order)
+    CALL save_variable(save_path, "Source_Force", self % Force)
+
+END SUBROUTINE save_params_ManualSources
+
+
+SUBROUTINE write_txt_ManualSources(self, unit)
+    ! -------------------------------------------------------------------------
+    ! Writes the first part of the sources block of the .dat summary: the title,
+    ! the counts and the positions. A child adds the rest of the input after it.
+    ! check_update compares this block to decide whether an existing output
+    ! holds the same case, so the block must list every input value.
+    ! -------------------------------------------------------------------------
+
+    CLASS(ManualSources_t), INTENT(IN) :: self    ! [-] Emitter instance
+    INTEGER(I32)          , INTENT(IN) :: unit    ! [-] Unit of the open .dat file
+
+    ! Local variables
+    INTEGER(I32) :: i_s
+
+
+    write(unit, '(A)') repeat('-', 70)
+    write(unit, '(A)') trim(self % title)
+    write(unit, '(A)') repeat('-', 70)
+    write(unit, '(A,I0)') 'N sources   : ', self % Nsources
+    write(unit, '(A,I0)') 'N freqs     : ', size(self % Freqs)
+    write(unit, '(A)')    'Multipole   : dipole'
+    write(unit, *)
+
+    write(unit, '(A)') '   #         x [m]         y [m]         z [m]'
+    do i_s = 1, self % Nsources
+        write(unit, '(I4,3F14.6)') i_s, self % xyz(i_s, :)
+    end do
+    write(unit, *)
+
+END SUBROUTINE write_txt_ManualSources
+
+END MODULE ManualSources
diff -ruN a/src/emitters/TimeSource.f90 b/src/emitters/TimeSource.f90
--- a/src/emitters/TimeSource.f90	1970-01-01 01:00:00.000000000 +0100
+++ b/src/emitters/TimeSource.f90	2026-10-06 18:21:50.689237191 +0200
@@ -0,0 +1,376 @@
+! ===============================================================================
+! MODULE: TimeSource
+! ===============================================================================
+! Defines TimeSource_t, an extension of ManualSources_t whose forces are given
+! in the time domain (TimeSource.nml): a real series of the force of every
+! source and component, read from a file or evaluated from a text expression
+! of t. The solver works in the frequency domain, so init takes the series
+! there with compute_rfft, the same routine that does it for the accelerations
+! of a turbine: mean removed, Hann window, one-sided spectrum. The forces are
+! therefore windowed and get_enbw returns HANN_ENBW, and a tone is read with
+! its full amplitude only if its frequency is a multiple of the frequency
+! resolution 1 / (record length).
+! -------------------------------------------------------------------------------
+! Author  : Raul Sanz Ramirez
+! Contact : raul.sanz.ramirez@upm.es
+! Affil.  : ETSIAE, Universidad Politecnica de Madrid
+! Project : ERC project off-coustics
+! Date    : 10/2026
+! ===============================================================================
+MODULE TimeSource
+
+USE Kinds, ONLY: I32, WP, DEFAULT_R
+USE CSVReader, ONLY: read_table
+USE ConfigTypes, ONLY: Config_t
+USE HDF5Utils, ONLY: save_variable
+USE SourceTypes, ONLY: SOURCE_DIPOLE
+USE ManualSources, ONLY: ManualSources_t
+USE SignalProcessing, ONLY: compute_rfft, HANN_ENBW
+USE ExpressionParser, ONLY: Expression_t, compile_expression, evaluate_expression
+
+IMPLICIT NONE
+
+PRIVATE
+PUBLIC :: TimeSource_t
+
+
+TYPE, EXTENDS(ManualSources_t) :: TimeSource_t
+    ! -------------------------------------------------------------------------
+    ! Point dipoles with a force series in time. The series and the input that
+    ! produced them are kept, besides the spectrum of ManualSources_t, to be
+    ! saved and listed in the .dat summary.
+    ! -------------------------------------------------------------------------
+
+    INTEGER(I32)                    :: Nt                 ! [-] Number of time samples
+    INTEGER(I32)                    :: skipf              ! [-] Keep 1 out of every skipf frequency bins
+    REAL(WP)                        :: dt                 ! [s] Time step
+    REAL(WP)                        :: fmin               ! [Hz] Lowest frequency kept (DEFAULT_R: all)
+    REAL(WP)                        :: fmax               ! [Hz] Highest frequency kept (DEFAULT_R: Nyquist)
+    REAL(WP)          , ALLOCATABLE :: time(:)            ! [s] Time axis (Nt)
+    REAL(WP)          , ALLOCATABLE :: Ft(:,:,:)          ! [N] Force series (Nt, Nsources, 3)
+    LOGICAL                         :: time_from_file     ! [-] Whether the time axis was read from time_file
+    LOGICAL                         :: force_from_file    ! [-] Whether the forces were read from force_file
+    CHARACTER(len=200)              :: time_file          ! [-] File of the time axis
+    CHARACTER(len=200)              :: force_file         ! [-] File of the forces
+    CHARACTER(len=256), ALLOCATABLE :: force_expr(:,:)    ! [-] Text expressions of the forces (Nsources, 3)
+
+    CONTAINS
+
+    ! --- Public type-bound procedures --- !
+    PROCEDURE :: init        => init_TimeSource           ! Builds the series and takes them to the frequency domain
+    PROCEDURE :: save_params => save_params_TimeSource    ! Adds the series to the HDF5 output
+    PROCEDURE :: write_txt   => write_txt_TimeSource      ! Adds the time axis and the series to the .dat
+    PROCEDURE :: get_enbw    => get_enbw_TimeSource       ! Hann window of compute_rfft (HANN_ENBW)
+
+END TYPE TimeSource_t
+
+
+CONTAINS
+
+
+SUBROUTINE init_TimeSource(self, config)
+    ! -------------------------------------------------------------------------
+    ! Builds the emitter from the configuration: the time axis (printing its
+    ! time step), the force series and their spectrum, which is what the
+    ! solver receives.
+    ! -------------------------------------------------------------------------
+
+    CLASS(TimeSource_t), INTENT(INOUT) :: self      ! [-] Emitter instance
+    TYPE(Config_t)     , INTENT(IN)    :: config    ! [-] Global configuration
+
+    ! Local variables
+    CHARACTER(len=16) :: nt_str
+
+
+    self % kind_name = 'TimeSource'
+    self % title     = 'TIME-DOMAIN SOURCES'
+
+    self % Nsources        = config % time_source % Nsources
+    self % xyz             = config % time_source % source_xyz
+    self % skipf           = config % time_source % skipf
+    self % fmin            = config % time_source % fmin
+    self % fmax            = config % time_source % fmax
+    self % time_from_file  = config % time_source % time_from_file
+    self % force_from_file = config % time_source % force_from_file
+    self % time_file       = config % time_source % time_file
+    self % force_file      = config % time_source % force_file
+    self % force_expr      = config % time_source % force_expr
+
+    ! Every source radiates as a point dipole
+    ALLOCATE(self % order(self % Nsources), source=SOURCE_DIPOLE)
+
+    CALL build_time_axis(self, config)
+    CALL build_force_series(self)
+    CALL take_to_frequency_domain(self)
+
+    write(nt_str, '(I0)') self % Nt
+    self % name_suffix = '_Nt' // trim(nt_str)
+
+END SUBROUTINE init_TimeSource
+
+
+SUBROUTINE build_time_axis(self, config)
+    ! -------------------------------------------------------------------------
+    ! Builds the time axis: Nt samples of [t_start, t_end), or the times of a
+    ! file, which must be uniformly spaced because the FFT needs a constant
+    ! time step. It prints the time step, the record length, the frequency
+    ! resolution and the Nyquist frequency, which the user needs to choose
+    ! the tones and the sampling.
+    ! -------------------------------------------------------------------------
+
+    CLASS(TimeSource_t), INTENT(INOUT) :: self      ! [-] Emitter instance
+    TYPE(Config_t)     , INTENT(IN)    :: config    ! [-] Global configuration
+
+    ! Local variables
+    REAL(WP), ALLOCATABLE :: table(:,:)
+    REAL(WP)              :: deviation
+    INTEGER(I32)          :: i
+
+
+    if (self % time_from_file) then
+        CALL read_table(self % time_file, 1_I32, table)
+
+        self % Nt = size(table, 1)
+        if (self % Nt < 4_I32) then
+            write(*, '(A,I0,A)') " ERROR TimeSource: the time file has ", self % Nt, &
+                                 " samples (at least 4 are required)"
+            error stop
+        end if
+
+        self % time = table(:, 1)
+        self % dt   = (self % time(self % Nt) - self % time(1)) / real(self % Nt - 1_I32, WP)
+
+        if (.not. self % dt > 0.0_WP) then
+            write(*,*) " ERROR TimeSource: the times of the time file must increase"
+            error stop
+        end if
+
+        deviation = maxval(abs(self % time(2:) - self % time(:self % Nt-1) - self % dt)) / self % dt
+        if (deviation > 1.0e-6_WP) then
+            write(*, '(A,ES9.2,A)') " ERROR TimeSource: the time file is not uniformly spaced (its time step " // &
+                                    "varies by ", deviation, " of its mean value); the FFT needs a constant time step"
+            error stop
+        end if
+    else
+        self % Nt = config % time_source % Nt
+        self % dt = (config % time_source % t_end - config % time_source % t_start) / real(self % Nt, WP)
+
+        ALLOCATE(self % time(self % Nt))
+        do i = 1, self % Nt
+            self % time(i) = config % time_source % t_start + real(i - 1_I32, WP) * self % dt
+        end do
+    end if
+
+    write(*, '(A,I0,A,ES12.5,A,ES12.5,A)') ' >> [TimeSource] Time axis: ', self % Nt, ' samples, time step dt = ', &
+                                            self % dt, ' s (sampling frequency ', 1.0_WP / self % dt, ' Hz)'
+    write(*, '(A,ES12.5,A,ES12.5,A,ES12.5,A)') ' >> [TimeSource] Record length = ', real(self % Nt, WP) * self % dt, &
+                                                ' s, frequency resolution df = ', &
+                                                1.0_WP / (real(self % Nt, WP) * self % dt), &
+                                                ' Hz, Nyquist frequency = ', 0.5_WP / self % dt, ' Hz'
+
+END SUBROUTINE build_time_axis
+
+
+SUBROUTINE build_force_series(self)
+    ! -------------------------------------------------------------------------
+    ! Builds the force series Ft (Nt, Nsources, 3): the columns of a file (Fx,
+    ! Fy, Fz of source 1, then those of source 2, ...) or the text expressions
+    ! evaluated at the time axis. A value that is not finite (a logarithm of a
+    ! negative number, a division by zero) stops the run, naming the force and
+    ! the first time at which it happens.
+    ! -------------------------------------------------------------------------
+
+    USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
+
+    CLASS(TimeSource_t), INTENT(INOUT) :: self    ! [-] Emitter instance
+
+    ! Local variables
+    CHARACTER(len=:), ALLOCATABLE :: message
+    CHARACTER(len=2)              :: component(3) = ['Fx', 'Fy', 'Fz']
+    REAL(WP)        , ALLOCATABLE :: table(:,:)
+    TYPE(Expression_t)            :: expr
+    INTEGER(I32)                  :: i_s, k, first_bad
+
+
+    ALLOCATE(self % Ft(self % Nt, self % Nsources, 3))
+
+    if (self % force_from_file) then
+        CALL read_table(self % force_file, 3_I32 * self % Nsources, table)
+
+        if (size(table, 1) /= self % Nt) then
+            write(*, '(A,I0,A,I0,A)') " ERROR TimeSource: the force file has ", size(table, 1), &
+                                      " rows and the time axis has ", self % Nt, " samples"
+            error stop
+        end if
+
+        do i_s = 1, self % Nsources
+            self % Ft(:, i_s, :) = table(:, 3*(i_s-1)+1:3*i_s)
+        end do
+    else
+        do i_s = 1, self % Nsources
+            do k = 1, 3
+                CALL compile_expression(self % force_expr(i_s, k), expr, message)
+                if (len(message) > 0) then
+                    write(*, '(A,I0,A)') " ERROR TimeSource: force_expr(", i_s, ", " // component(k) // "): " // message
+                    error stop
+                end if
+
+                CALL evaluate_expression(expr, self % time, self % Ft(:, i_s, k))
+            end do
+        end do
+    end if
+
+    do i_s = 1, self % Nsources
+        do k = 1, 3
+            if (.not. all(ieee_is_finite(self % Ft(:, i_s, k)))) then
+                first_bad = minloc(merge(1, 0, ieee_is_finite(self % Ft(:, i_s, k))), dim=1)
+                write(*, '(A,I0,A,ES12.5,A)') " ERROR TimeSource: the force " // component(k) // " of source ", i_s, &
+                                              " is not finite at t = ", self % time(first_bad), " s"
+                error stop
+            end if
+        end do
+    end do
+
+END SUBROUTINE build_force_series
+
+
+SUBROUTINE take_to_frequency_domain(self)
+    ! -------------------------------------------------------------------------
+    ! Takes the force series to the frequency domain with compute_rfft and keeps
+    ! the frequencies of the band fmin to fmax (and one out of every skipf
+    ! bins). They are the Freqs and Force that the solver receives. The zero
+    ! frequency is never kept: a constant force does not radiate.
+    ! -------------------------------------------------------------------------
+
+    CLASS(TimeSource_t), INTENT(INOUT) :: self    ! [-] Emitter instance
+
+    ! Local variables
+    COMPLEX(WP) , ALLOCATABLE :: spectrum(:,:,:)
+    REAL(WP)    , ALLOCATABLE :: f(:)
+    INTEGER(I32), ALLOCATABLE :: kept(:)
+    LOGICAL     , ALLOCATABLE :: in_band(:)
+    REAL(WP)                  :: f_low, f_high
+    INTEGER(I32)              :: i
+
+
+    CALL compute_rfft(self % Ft, self % Nt, self % dt, skipf=self % skipf, remove_zero=.true., &
+                      array_out=spectrum, freqs=f)
+
+    f_low  = 0.0_WP
+    f_high = huge(1.0_WP)
+    if (self % fmin /= DEFAULT_R) f_low  = self % fmin
+    if (self % fmax /= DEFAULT_R) f_high = self % fmax
+
+    if (f_high > 0.5_WP / self % dt .and. self % fmax /= DEFAULT_R) &
+        write(*, '(A,ES10.3,A,ES10.3,A)') " WARNING TimeSource: fmax = ", self % fmax, &
+                                          " Hz is above the Nyquist frequency ", 0.5_WP / self % dt, " Hz"
+
+    in_band = f >= f_low .and. f <= f_high
+    if (.not. any(in_band)) then
+        write(*, '(A,ES10.3,A,ES10.3,A)') " ERROR TimeSource: no frequency of the spectrum (", f(1), " to ", &
+                                          f(size(f)), " Hz) is inside fmin and fmax"
+        error stop
+    end if
+
+    kept         = pack([(i, i = 1_I32, size(f))], in_band)
+    self % Freqs = f(kept)
+    self % Force = spectrum(kept, :, :)
+
+    write(*, '(A,I0,A,ES10.3,A,ES10.3,A)') ' >> [TimeSource] Forces taken to the frequency domain (Hann window): ', &
+                                           size(kept), ' frequencies from ', self % Freqs(1), ' to ', &
+                                           self % Freqs(size(kept)), ' Hz'
+
+END SUBROUTINE take_to_frequency_domain
+
